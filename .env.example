# Vercel / local runtime (never commit real values)
# Set these in Vercel Project → Settings → Environment Variables
# for BOTH Production and Preview on compsany-site, then redeploy.
# Readiness probe (no secrets): GET /api/health

ADMIN_EMAIL=
POS_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
POS_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
COMPANY_INQUIRY_HMAC_SECRET=YOUR_HMAC_SECRET_MIN_32_CHARS

# Matching database secret (owner sets in Supabase SQL Editor, not in Git):
# insert into company.runtime_secrets (key, value)
# values ('inquiry_hmac_secret', '<same secret as COMPANY_INQUIRY_HMAC_SECRET>')
# on conflict (key) do update set value = excluded.value;
